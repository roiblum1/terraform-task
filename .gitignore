# Terraform working state — never commit, may contain secrets in plaintext
**/.terraform/
**/.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
*.tfstate.backup

# Student-filled variable files — contain the vSphere password / site-specific
# values. terraform.tfvars.example is the only tfvars file that IS committed.
*.tfvars
!*.tfvars.example

# Terraform plan output
*.tfplan
tfplan

# Part D output — generated, not source
inventory.ini

# OS / editor cruft
.DS_Store
*.swp
